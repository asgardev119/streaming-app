Excel sheet extentsions apps script -> .gc file code - 

// ===== SETTINGS =====
const SHEET_NAME = 'Users';
const ADMIN_EMAIL = 'you@gmail.com'; //  admin email (.env wala hi)


function doGet() {
  return json({ ok: true, message: 'StreamHub API running' });
}

function doPost(e) {
  try {
    return handle(e);
  } catch (err) {
    return json({ ok: false, error: 'Server error: ' + err.message });
  }
}

function handle(e) {
  const body = JSON.parse(e.postData.contents);
  const props = PropertiesService.getScriptProperties();

  if (body.action === 'liveStatus') {
    const t = Number(props.getProperty('liveAt') || 0);
    return json({ ok: true, live: Date.now() - t < 60000 });
  }

  const sh = SpreadsheetApp.getActive().getSheetByName(SHEET_NAME);
  if (!sh) return json({ ok: false, error: 'Sheet tab "Users" nahi mila' });

  const rows = sh.getDataRange().getValues();
  const email = String(body.email || '').trim().toLowerCase();
  const idx = rows.findIndex(
    (r, i) => i > 0 && String(r[3]).trim().toLowerCase() === email
  );

  // ----- Signup -----
  if (body.action === 'signup') {
    if (idx > 0) return json({ ok: false, error: 'Ye email already registered hai' });
    sh.appendRow([new Date(), body.name, body.phone, email, body.passHash, 'Pending', '', '']);
    return json({ ok: true, message: 'Signup ho gaya. Admin verify karega, phir login karein.' });
  }

  // Baaki sab actions ke liye user exist aur password sahi hona chahiye
  if (idx < 1) return json({ ok: false, error: 'User nahi mila' });
  const row = rows[idx];
  if (String(row[4]) !== body.passHash) return json({ ok: false, error: 'Password galat hai' });

  // ----- Login -----
  if (body.action === 'login') {
    return json({
      ok: true,
      user: {
        name: row[1],
        status: row[5],
        paidUntil: row[6] ? new Date(row[6]).toISOString() : null,
      },
    });
  }

  // ----- Payment submit (UTR) -----
  if (body.action === 'payment') {
    sh.getRange(idx + 1, 6).setValue('Payment Submitted');
    sh.getRange(idx + 1, 8).setValue(body.utr);
    return json({ ok: true });
  }

  // ----- Admin: stream live heartbeat -----
  if (body.action === 'setLive') {
    if (email !== ADMIN_EMAIL.trim().toLowerCase()) {
      return json({ ok: false, error: 'Sirf admin' });
    }
    props.setProperty('liveAt', String(Date.now()));
    return json({ ok: true });
  }

  return json({ ok: false, error: 'Unknown action' });
}

function json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

// ===== ADMIN MENU (sirf Sheet ke andar se bani script mein kaam karta hai) =====
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Admin')
    .addItem('Verify Selected', 'verifySelected')
    .addToUi();
}

function verifySelected() {
  const sh = SpreadsheetApp.getActiveSheet();
  const row = sh.getActiveRange().getRow();
  if (row < 2) return;
  const until = new Date();
  until.setDate(until.getDate() + 30);
  sh.getRange(row, 6).setValue('Verified');
  sh.getRange(row, 7).setValue(until);
  SpreadsheetApp.getActive().toast('User verified, 30 din ka subscription laga diya');
}

